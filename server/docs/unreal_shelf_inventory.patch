+bool AAGVDisplayShelf::IsSlotSnapshotValid() const
+{
+    if (Slots.Num() <= 0 || Slots.Num() > 128 || OccupiedSlots.Num() != Slots.Num())
+    {
+        return false;
+    }
+    for (const TObjectPtr<USceneComponent>& Slot : Slots)
+    {
+        if (!IsValid(Slot.Get()))
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
 bool AAGVDisplayShelf::IsSlotOccupied(int32 SlotIndex) const
 {
     return OccupiedSlots.IsValidIndex(SlotIndex)
