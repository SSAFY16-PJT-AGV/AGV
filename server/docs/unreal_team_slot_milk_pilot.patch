+// The pilot binds milk to the existing Red demo asset. It is synthetic and
+// intentionally does not claim support for the other team product types yet.
+static bool TeamSlotStop(UWorld* World, int32 SlotId, FVector& Out)
+{
+    if (!IsValid(World) || !IsInGameThread() || SlotId < 1 || SlotId > 8) return false;
+    AWarehouseMapLoader* Loader = nullptr;
+    for (TActorIterator<AWarehouseMapLoader> It(World); It; ++It)
+    {
+        if (!IsValid(*It) || Loader) return false;
+        Loader = *It;
+    }
+    if (!Loader || Loader->LoadedMapId != TEXT("mat_ssafy_v3")) return false;
+    const FString NodeId = SlotId <= 4 ? TEXT("D01") : TEXT("D02");
+    int32 Matches = 0;
+    for (const FWarehouseNode& Node : Loader->Nodes)
+        if (Node.Id == NodeId) { Out = Node.Position; ++Matches; }
+    return Matches == 1 && !Out.ContainsNaN();
+}
+
+bool AAGVRobot::TeamSlotTargetMatches(int32 SlotId, double X, double Y) const
+{
+    FVector Node;
+    if (!FMath::IsFinite(X) || !FMath::IsFinite(Y) || !TeamSlotStop(GetWorld(), SlotId, Node)) return false;
+    const float Scale = GetExternalPositionScale();
+    return FMath::IsFinite(Scale) && Scale > 0 &&
+        FVector::Dist2D(Node, FVector(X * Scale, Y * Scale, Node.Z)) <= 0.1f &&
+        FVector::Dist2D(GetActorLocation(), Node) <= 25.0f;
+}
+
+bool AAGVRobot::ApplyTeamSlotPick(int32 SlotId)
+{
+    if (SlotId < 1 || SlotId > 4 || MovementMode != EAGVMovementMode::External ||
+        !IsValid(GrabPoint) || IsValid(HeldActor)) return false;
+    FVector Node;
+    if (!TeamSlotStop(GetWorld(), SlotId, Node) || FVector::Dist2D(GetActorLocation(), Node) > 25.0f) return false;
+    const FName Tag(*FString::Printf(TEXT("TEAM_V3_SLOT_%d"), SlotId));
+    AAGVGrabbableObject* Selected = nullptr;
+    for (TActorIterator<AAGVGrabbableObject> It(GetWorld()); It; ++It)
+    {
+        AAGVGrabbableObject* Candidate = *It;
+        if (!IsValid(Candidate)) return false;
+        if (!Candidate->ActorHasTag(Tag)) continue;
+        if (Selected) return false;
+        Selected = Candidate;
+    }
+    if (!IsValid(Selected) || Selected->bIsGrabbed || Selected->GetProductType() != EProductType::Red ||
+        FVector::Dist2D(Selected->GetActorLocation(), Node) > 12.0f) return false;
+    for (TActorIterator<AAGVDisplayShelf> It(GetWorld()); It; ++It)
+        if (!IsValid(*It) || It->FindProductSlot(Selected) != INDEX_NONE) return false;
+    Selected->Grab(GrabPoint);
+    if (!Selected->bIsGrabbed) return false;
+    HeldActor = Selected;
+    return true;
+}
+
+bool AAGVRobot::ApplyTeamSlotPlace(int32 SlotId)
+{
+    if (SlotId < 5 || SlotId > 8 || MovementMode != EAGVMovementMode::External ||
+        !IsValid(HeldActor) || HeldActor->GetProductType() != EProductType::Red) return false;
+    FVector Node;
+    if (!TeamSlotStop(GetWorld(), SlotId, Node) || FVector::Dist2D(GetActorLocation(), Node) > 25.0f) return false;
+    AAGVDisplayShelf* Shelf = nullptr;
+    for (TActorIterator<AAGVDisplayShelf> It(GetWorld()); It; ++It)
+    {
+        if (!IsValid(*It)) return false;
+        if (It->GetShelfId() != TEXT("SHELF_RED")) continue;
+        if (Shelf) return false;
+        Shelf = *It;
+    }
+    if (!IsValid(Shelf) || !Shelf->ActorHasTag(TEXT("TEAM_V3_SHELF")) || Shelf->GetSlotCount() != 4 ||
+        Shelf->GetShelfProductType() != EProductType::Red ||
+        FVector::Dist2D(Shelf->GetActorLocation(), Node) > 10.0f || Shelf->IsSlotOccupied(SlotId - 5)) return false;
+    if (!Shelf->PlaceProductAtSlot(HeldActor, SlotId - 5)) return false;
+    for (int32 Index = 1; Index <= 4; ++Index)
+        HeldActor->Tags.Remove(FName(*FString::Printf(TEXT("TEAM_V3_SLOT_%d"), Index)));
+    HeldActor->Tags.AddUnique(FName(*FString::Printf(TEXT("TEAM_V3_SLOT_%d"), SlotId)));
+    HeldActor = nullptr;
+    if (IsValid(PlacementPreview)) PlacementPreview->HidePreview();
+    AimedShelf = nullptr;
+    AimedSlotIndex = INDEX_NONE;
+    return true;
+}
