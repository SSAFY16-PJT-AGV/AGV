+// The v3 demo has a purpose-built camera. Wait for the actual selected map
+// and select it once only when one loader and one camera are present.
+// Controller possession and input bindings are deliberately unchanged.
+void AWarehouseCameraPawn::UpdateV3ViewTarget()
+{
+    if (!GetWorld()) return;
+    AWarehouseMapLoader* Loader = nullptr;
+    for (TActorIterator<AWarehouseMapLoader> It(GetWorld()); It; ++It)
+    {
+        if (!IsValid(*It) || Loader) return;
+        Loader = *It;
+    }
+    if (!Loader || Loader->LoadedMapId.IsEmpty()) return;
+    APlayerController* PC = GetWorld()->GetFirstPlayerController();
+    if (!IsValid(PC)) return;
+
+    if (Loader->LoadedMapId != TEXT("mat_ssafy_v3"))
+    {
+        if (bV3ViewActive)
+        {
+            if (PC->GetViewTarget() == this && PreviousV3ViewTarget.IsValid())
+                PC->SetViewTarget(PreviousV3ViewTarget.Get());
+            PreviousV3ViewTarget.Reset();
+            bV3ViewActive = false;
+        }
+        bV3ViewAttempted = false;
+        return;
+    }
+
+    int32 CameraCount = 0;
+    for (TActorIterator<AWarehouseCameraPawn> It(GetWorld()); It; ++It)
+    {
+        if (!IsValid(*It)) return;
+        ++CameraCount;
+    }
+    if (CameraCount != 1 || !IsValid(Camera) || bV3ViewAttempted) return;
+    bV3ViewAttempted = true;
+    AActor* Previous = PC->GetViewTarget();
+    if (Previous != this)
+    {
+        PreviousV3ViewTarget = Previous;
+        PC->SetViewTarget(this);
+    }
+    bV3ViewActive = PC->GetViewTarget() == this;
+    const FVector CameraPosition = Camera->GetComponentLocation();
+    const FRotator CameraRotation = Camera->GetComponentRotation();
+    UE_LOG(LogTemp, Display,
+        TEXT("[V3Camera] controller=%s target=%s verified=%d camera_position=%s camera_rotation=%s"),
+        *GetNameSafe(PC), *GetNameSafe(PC->GetViewTarget()), bV3ViewActive ? 1 : 0,
+        *CameraPosition.ToString(), *CameraRotation.ToString());
+}
+
 void AWarehouseCameraPawn::Tick(float DeltaTime)
 {
     Super::Tick(DeltaTime);
+    UpdateV3ViewTarget();
 }
 
