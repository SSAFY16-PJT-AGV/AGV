diff --git a/Source/agvSimulation/AGVWebSocketClient.cpp b/Source/agvSimulation/AGVWebSocketClient.cpp
--- a/Source/agvSimulation/AGVWebSocketClient.cpp
+++ b/Source/agvSimulation/AGVWebSocketClient.cpp
@@ -74 +74,9 @@ void AAGVWebSocketClient::ConnectToServer()
