+// The old warehouse level is roughly 10x larger than the v3 metre map.
+// Wait until one map loader has successfully loaded its data; actor and
+// loader BeginPlay ordering is not guaranteed. Never alter an unknown map.
+void AAGVRobot::UpdateV3DisplayScale()
+{
+    if (!GetWorld()) return;
+    AWarehouseMapLoader* UniqueLoader = nullptr;
+    for (TActorIterator<AWarehouseMapLoader> It(GetWorld()); It; ++It)
+    {
+        if (!IsValid(*It) || UniqueLoader) return;
+        UniqueLoader = *It;
+    }
+    if (!UniqueLoader || UniqueLoader->LoadedMapId.IsEmpty()) return;
+    if (UniqueLoader->LoadedMapId == TEXT("mat_ssafy_v3"))
+    {
+        if (!bV3DisplayScaleActive)
+        {
+            DisplayScaleBeforeV3 = GetActorScale3D();
+            SetActorScale3D(FVector(0.1f));
+            bV3DisplayScaleActive = true;
+        }
+    }
+    else if (bV3DisplayScaleActive)
+    {
+        SetActorScale3D(DisplayScaleBeforeV3);
+        bV3DisplayScaleActive = false;
+    }
+}
+
 void AAGVRobot::Tick(float DeltaTime)
 {
     Super::Tick(DeltaTime);
+    UpdateV3DisplayScale();
 
