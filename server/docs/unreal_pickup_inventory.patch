+// Both the snapshot and the grab use these exact demo source rules.
+// Items and node positions belong to this UWorld; never infer stock in another world.
+static bool CollectPickupObjects(UWorld* World, EProductType ProductType,
+    FVector& OutCenter, TArray<AAGVGrabbableObject*>& OutCandidates)
+{
+    if (!IsValid(World) || !IsInGameThread()) return false;
+    FString NodeId;
+    if (ProductType == EProductType::Red) NodeId = TEXT("D01");
+    else if (ProductType == EProductType::Blue) NodeId = TEXT("D06");
+    else return false;
+
+    int32 LoaderCount = 0;
+    int32 NodeCount = 0;
+    for (TActorIterator<AWarehouseMapLoader> It(World); It; ++It)
+    {
+        if (!IsValid(*It)) return false;
+        ++LoaderCount;
+        for (const FWarehouseNode& Node : It->Nodes)
+        {
+            if (Node.Id == NodeId) { OutCenter = Node.Position; ++NodeCount; }
+        }
+    }
+    if (LoaderCount != 1 || NodeCount != 1 || OutCenter.ContainsNaN()) return false;
+    TArray<AAGVDisplayShelf*> Shelves;
+    for (TActorIterator<AAGVDisplayShelf> It(World); It; ++It)
+    {
+        if (!IsValid(*It) || !It->IsSlotSnapshotValid()) return false;
+        Shelves.Add(*It);
+    }
+    if (Shelves.Num() != 2) return false;
+    for (TActorIterator<AAGVGrabbableObject> It(World); It; ++It)
+    {
+        AAGVGrabbableObject* Candidate = *It;
+        if (!IsValid(Candidate)) return false;
+        if (Candidate->bIsGrabbed || Candidate->GetProductType() != ProductType) continue;
+        bool bOnShelf = false;
+        for (AAGVDisplayShelf* Shelf : Shelves)
+        {
+            if (Shelf->FindProductSlot(Candidate) != INDEX_NONE) { bOnShelf = true; break; }
+        }
+        if (bOnShelf) continue;
+        const FVector Position = Candidate->GetActorLocation();
+        if (Position.ContainsNaN()) return false;
+        if (FVector::Dist2D(Position, OutCenter) <= 200.0)
+            OutCandidates.Add(Candidate);
+    }
+    return true;
+}
+
+bool AAGVRobot::GetPickupAvailability(UWorld* World, EProductType ProductType,
+    int32& OutCount, FVector& OutCenter)
+{
+    TArray<AAGVGrabbableObject*> Candidates;
+    if (!CollectPickupObjects(World, ProductType, OutCenter, Candidates)) return false;
+    OutCount = Candidates.Num();
+    return true;
+}
