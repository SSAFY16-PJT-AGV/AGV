+
+// v3 scene coordinates are an explicit simulation arrangement, not measured
+// physical warehouse coordinates. Do not acknowledge a place into a shelf
+// that is not near the mapped node, or a robot that has not reached it.
+static bool V3ShelfLocationMatches(UWorld* World, const AAGVDisplayShelf* Shelf,
+    const FVector& RobotPosition)
+{
+    if (!IsValid(World) || !IsValid(Shelf) || !IsInGameThread() || RobotPosition.ContainsNaN()) return false;
+    AWarehouseMapLoader* Loader = nullptr;
+    for (TActorIterator<AWarehouseMapLoader> It(World); It; ++It)
+    {
+        if (!IsValid(*It) || Loader) return false;
+        Loader = *It;
+    }
+    if (!Loader) return false;
+    if (Loader->LoadedMapId != TEXT("mat_ssafy_v3")) return true;
+    FString Target;
+    if (Shelf->GetShelfId() == TEXT("SHELF_RED")) Target = TEXT("D04");
+    else if (Shelf->GetShelfId() == TEXT("SHELF_BLUE")) Target = TEXT("D03");
+    else return false;
+    int32 Matches = 0;
+    FVector NodePosition = FVector::ZeroVector;
+    for (const FWarehouseNode& Node : Loader->Nodes)
+    {
+        if (Node.Id == Target) { NodePosition = Node.Position; ++Matches; }
+    }
+    const FVector ShelfPosition = Shelf->GetActorLocation();
+    return Matches == 1 && !NodePosition.ContainsNaN() && !ShelfPosition.ContainsNaN()
+        && FVector::Dist2D(ShelfPosition, NodePosition) <= 10.0
+        && FVector::Dist2D(RobotPosition, NodePosition) <= 25.0;
 }
 
